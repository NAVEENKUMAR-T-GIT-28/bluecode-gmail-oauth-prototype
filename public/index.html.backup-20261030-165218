<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>BlueCode OS · Gmail Connect Demo</title>
  <style>
    :root{font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;color:#172033;background:#f4f6fa}
    *{box-sizing:border-box}body{margin:0}.wrap{max-width:1000px;margin:36px auto;padding:0 18px}
    header{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:24px}
    .brand{font-weight:800;font-size:22px;letter-spacing:-.5px}.brand span{color:#f07832}
    .sub{color:#647084;font-size:13px;margin-top:5px}.pill{border-radius:99px;background:#e9edf4;padding:7px 11px;font-size:12px}
    .grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.card{background:white;border:1px solid #e3e8f0;border-radius:16px;padding:22px;box-shadow:0 8px 28px #18233a08}
    h2{font-size:17px;margin:0 0 8px}p{color:#687386;font-size:13px;line-height:1.55}
    button{border:0;border-radius:9px;padding:11px 15px;font-weight:700;cursor:pointer;background:#172033;color:white}
    button.secondary{background:#edf0f5;color:#253047}button.danger{background:#fff0ed;color:#b43b26}
    .status{font-size:13px;padding:12px;border-radius:10px;background:#f3f6fa;margin:15px 0}
    label{display:block;font-size:12px;font-weight:700;margin:13px 0 6px;color:#475267}
    input,textarea{width:100%;padding:11px;border:1px solid #dce2eb;border-radius:9px;font:inherit;font-size:14px}
    textarea{min-height:140px;resize:vertical}.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:14px}
    .wide{grid-column:1/-1}.mail{border-top:1px solid #edf0f4;padding:13px 0}.mail:first-child{border-top:0}
    .mail strong{font-size:14px}.meta{font-size:12px;color:#788397;margin-top:4px}
    .events{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.event{font-size:11px;background:#eef3fa;padding:4px 8px;border-radius:99px}
    .notice{background:#fff8e9;border:1px solid #f5dfad;padding:12px;border-radius:10px;color:#75551c;font-size:12px;line-height:1.5;margin-top:14px}
    #toast{position:fixed;bottom:20px;right:20px;background:#172033;color:white;padding:12px 16px;border-radius:10px;display:none;max-width:360px}
    @media(max-width:700px){.grid{grid-template-columns:1fr}.wide{grid-column:auto}header{align-items:flex-start;flex-direction:column}}
  </style>
</head>
<body>
<div class="wrap">
  <header><div><div class="brand">BlueCode <span>OS</span></div><div class="sub">Gmail OAuth · Sending · Tracking prototype</div></div><div class="pill">LOCAL DEVELOPMENT DEMO</div></header>
  <div class="grid">
    <section class="card">
      <h2>1. Connect your Gmail</h2>
      <p>Authorize BlueCode OS to send emails from your Google account. Your Gmail password is never requested or stored.</p>
      <div class="status" id="connection">Checking Gmail connection…</div>
      <div class="actions"><button id="connect">Connect Gmail with Google</button><button class="secondary" id="refresh">Refresh</button><button class="danger" id="disconnect">Disconnect</button></div>
    </section>
    <section class="card">
      <h2>2. How this demo works</h2>
      <p>Google OAuth gives the backend permission to send. The backend stores encrypted tokens in MongoDB and uses the connected account for each send.</p>
      <p><b>Tracking:</b> a 1×1 pixel records image requests; tracked links record clicks before redirecting.</p>
      <div class="notice">Open and click events are approximate. Mail privacy proxies and security scanners may trigger them automatically. A Gmail API send response means accepted for sending, not confirmed delivery.</div>
    </section>
    <section class="card wide">
      <h2>3. Compose and send</h2>
      <p>The sender is selected automatically from the Gmail account connected above.</p>
      <form id="sendForm">
        <label>Recipient</label><input id="to" type="email" placeholder="recipient@example.com" required />
        <label>Subject</label><input id="subject" placeholder="A message from BlueCode OS" required />
        <label>Message</label><textarea id="body" placeholder="Hi,&#10;&#10;This is a test email sent through my connected Gmail account.&#10;&#10;Regards"></textarea>
        <div class="actions"><button type="submit">Send test email</button></div>
      </form>
    </section>
    <section class="card wide">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:12px"><div><h2>4. Email activity</h2><p>Submission, open-pixel and tracked-link events.</p></div><button class="secondary" id="reloadLogs">Refresh activity</button></div>
      <div id="logs">No emails yet.</div>
    </section>
  </div>
</div>
<div id="toast"></div>
<script>
const $ = id => document.getElementById(id);
function toast(message){$('toast').textContent=message;$('toast').style.display='block';setTimeout(()=>$('toast').style.display='none',4500)}
async function api(url, options={}){const r=await fetch(url,{...options,headers:{'Content-Type':'application/json',...(options.headers||{})}});const data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.error||'Request failed');return data}
async function loadConnection(){try{const d=await api('/api/connection');$('connection').textContent=d.connected?'Connected as '+d.email:'No Gmail account connected';$('connect').textContent=d.connected?'Reconnect Gmail':'Connect Gmail with Google';$('sendForm').querySelector('button').disabled=!d.connected;}catch(e){$('connection').textContent=e.message}}
async function loadLogs(){try{const logs=await api('/api/emails');if(!logs.length){$('logs').textContent='No emails sent yet.';return}$('logs').innerHTML=logs.map(m=>`<div class="mail"><strong>${esc(m.subject||'(no subject)')}</strong><div class="meta">${esc(m.sender||'')} → ${esc(m.recipient||'')} · ${new Date(m.createdAt).toLocaleString()}</div><div class="events">${(m.events||[]).map(e=>`<span class="event">${esc(e.type)} · ${new Date(e.at).toLocaleTimeString()}</span>`).join('')}</div></div>`).join('')}catch(e){$('logs').textContent=e.message}}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
$('connect').onclick=()=>location.href='/auth/google';
$('refresh').onclick=loadConnection;
$('reloadLogs').onclick=loadLogs;
$('disconnect').onclick=async()=>{try{await api('/api/disconnect',{method:'POST'});toast('Gmail disconnected');await loadConnection()}catch(e){toast(e.message)}};
$('sendForm').onsubmit=async e=>{e.preventDefault();try{const d=await api('/api/send',{method:'POST',body:JSON.stringify({to:$('to').value,subject:$('subject').value,body:$('body').value})});toast('Gmail accepted the message from '+d.sender);$('sendForm').reset();await loadLogs()}catch(err){toast(err.message)}};
const params=new URLSearchParams(location.search);if(params.get('oauth')==='connected')toast('Gmail connected successfully');if(params.get('oauth')==='denied')toast('Google authorization was cancelled');history.replaceState({},'',location.pathname);
loadConnection();loadLogs();
</script>
</body>
</html>
