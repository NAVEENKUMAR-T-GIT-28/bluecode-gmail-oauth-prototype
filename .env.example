PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/bluecode_os_email

GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# 32 random bytes, hex encoded (64 characters)
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SESSION_SECRET

# Public HTTPS URL used in tracking pixels and redirects (ngrok for local testing)
PUBLIC_TRACKING_URL=http://localhost:5000

# Demo owner identity only. Replace getUserId() with your authenticated BlueCode OS user ID.
DEMO_USER_ID=demo-user-001

# Periodic Gmail sync cadence and batch size
GMAIL_SYNC_INTERVAL_MS=60000
GMAIL_SYNC_MAX_MESSAGES=50
SESSION_COOKIE_SECURE=false
