PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bluecode_gmail_demo

# Create a Web application OAuth client in Google Cloud Console
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Generate a random 32-byte key and encode as 64 hexadecimal characters.
# Example: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Set this to your ngrok HTTPS URL when you want remote recipients' tracking
# pixel and click links to reach your local machine. Example:
# PUBLIC_TRACKING_URL=https://abc123.ngrok-free.app
PUBLIC_TRACKING_URL=http://localhost:5000

SESSION_SECRET=replace-this-with-a-long-random-session-secret
DEMO_USER_ID=demo-user-001
