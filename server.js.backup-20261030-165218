require("dotenv").config();

const express = require("express");
const session = require("express-session");
const mongoose = require("mongoose");
const crypto = require("crypto");
const path = require("path");
const { google } = require("googleapis");

const app = express();
const PORT = Number(process.env.PORT || 5000);
const SCOPES = ["openid", "email", "https://www.googleapis.com/auth/gmail.send"];
const DEMO_USER_ID = process.env.DEMO_USER_ID || "demo-user-001";
const TRACKING_BASE = (process.env.PUBLIC_TRACKING_URL || `http://localhost:${PORT}`).replace(/\/$/, "");

app.use(express.json({ limit: "1mb" }));
app.use(session({
  secret: process.env.SESSION_SECRET || "local-only-change-me",
  resave: false,
  saveUninitialized: false,
  cookie: { httpOnly: true, sameSite: "lax", secure: false, maxAge: 24 * 60 * 60 * 1000 }
}));
app.use(express.static(path.join(__dirname, "public")));

const connectionSchema = new mongoose.Schema({
  userId: { type: String, required: true, unique: true, index: true },
  email: { type: String, required: true },
  encryptedTokens: { type: String, required: true },
  connectedAt: { type: Date, default: Date.now }
});

const eventSchema = new mongoose.Schema({
  type: { type: String, enum: ["submitted", "opened", "clicked"], required: true },
  at: { type: Date, default: Date.now },
  detail: String,
  userAgent: String
}, { _id: false });

const emailSchema = new mongoose.Schema({
  userId: { type: String, required: true, index: true },
  sender: String,
  recipient: String,
  subject: String,
  gmailMessageId: String,
  status: { type: String, default: "submitted" },
  events: [eventSchema],
  createdAt: { type: Date, default: Date.now }
});

const EmailConnection = mongoose.model("EmailConnection", connectionSchema);
const EmailLog = mongoose.model("EmailLog", emailSchema);

function encryptionKey() {
  const hex = process.env.TOKEN_ENCRYPTION_KEY || "";
  if (!/^[0-9a-fA-F]{64}$/.test(hex)) {
    throw new Error("TOKEN_ENCRYPTION_KEY must be exactly 64 hexadecimal characters. Generate one with: openssl rand -hex 32");
  }
  return Buffer.from(hex, "hex");
}
function encrypt(value) {
  const iv = crypto.randomBytes(12);
  const cipher = crypto.createCipheriv("aes-256-gcm", encryptionKey(), iv);
  const encrypted = Buffer.concat([cipher.update(JSON.stringify(value), "utf8"), cipher.final()]);
  const tag = cipher.getAuthTag();
  return [iv, tag, encrypted].map(x => x.toString("base64")).join(".");
}
function decrypt(value) {
  const [ivB64, tagB64, dataB64] = value.split(".");
  const decipher = crypto.createDecipheriv("aes-256-gcm", encryptionKey(), Buffer.from(ivB64, "base64"));
  decipher.setAuthTag(Buffer.from(tagB64, "base64"));
  return JSON.parse(Buffer.concat([decipher.update(Buffer.from(dataB64, "base64")), decipher.final()]).toString("utf8"));
}
function oauthClient() {
  if (!process.env.GOOGLE_CLIENT_ID || !process.env.GOOGLE_CLIENT_SECRET || !process.env.GOOGLE_REDIRECT_URI) {
    throw new Error("Set GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and GOOGLE_REDIRECT_URI in .env");
  }
  return new google.auth.OAuth2(
    process.env.GOOGLE_CLIENT_ID,
    process.env.GOOGLE_CLIENT_SECRET,
    process.env.GOOGLE_REDIRECT_URI
  );
}
function requireDemoSession(req, res, next) {
  // Prototype only: one local demo identity. Replace with real BlueCode OS auth before multi-user use.
  if (!req.session.userId) req.session.userId = DEMO_USER_ID;
  next();
}
app.use("/api", requireDemoSession);

app.get("/auth/google", requireDemoSession, (req, res) => {
  try {
    const oauth2 = oauthClient();
    const state = crypto.randomBytes(24).toString("hex");
    req.session.oauthState = state;
    const url = oauth2.generateAuthUrl({
      access_type: "offline",
      prompt: "consent",
      include_granted_scopes: true,
      scope: SCOPES,
      state
    });
    res.redirect(url);
  } catch (e) {
    res.status(500).send(e.message);
  }
});

app.get("/auth/google/callback", requireDemoSession, async (req, res) => {
  try {
    if (!req.query.state || req.query.state !== req.session.oauthState) {
      return res.status(400).send("OAuth state validation failed. Restart the Gmail connection flow.");
    }
    delete req.session.oauthState;
    if (req.query.error) return res.redirect("/?oauth=denied");
    const oauth2 = oauthClient();
    const { tokens } = await oauth2.getToken(String(req.query.code || ""));
    oauth2.setCredentials(tokens);
    // Use OpenID Connect userinfo to identify the connected Google account.
    // This avoids requesting Gmail read/profile scopes: the app only needs gmail.send.
    const oauthUserInfo = google.oauth2({ version: "v2", auth: oauth2 });
    const profile = await oauthUserInfo.userinfo.get();
    const email = profile.data.email;
    if (!email) throw new Error("Google did not return an email address.");

    const previous = await EmailConnection.findOne({ userId: req.session.userId });
    const mergedTokens = { ...(previous ? decrypt(previous.encryptedTokens) : {}), ...tokens };
    if (!mergedTokens.refresh_token && previous) {
      mergedTokens.refresh_token = decrypt(previous.encryptedTokens).refresh_token;
    }
    await EmailConnection.findOneAndUpdate(
      { userId: req.session.userId },
      { userId: req.session.userId, email, encryptedTokens: encrypt(mergedTokens), connectedAt: new Date() },
      { upsert: true, new: true }
    );
    res.redirect("/?oauth=connected");
  } catch (e) {
    console.error("OAuth callback error:", e.message);
    res.status(500).send(`Gmail connection failed: ${e.message}`);
  }
});

app.get("/api/connection", async (req, res) => {
  const connection = await EmailConnection.findOne({ userId: req.session.userId }).lean();
  res.json({ connected: !!connection, email: connection?.email || null });
});

app.post("/api/disconnect", async (req, res) => {
  const connection = await EmailConnection.findOne({ userId: req.session.userId });
  if (connection) {
    try {
      const tokens = decrypt(connection.encryptedTokens);
      if (tokens.refresh_token) {
        const oauth2 = oauthClient();
        oauth2.setCredentials({ refresh_token: tokens.refresh_token });
        await oauth2.revokeCredentials();
      }
    } catch (e) {
      console.warn("Token revocation warning:", e.message);
    }
    await EmailConnection.deleteOne({ _id: connection._id });
  }
  res.json({ ok: true });
});

function base64Url(input) {
  return Buffer.from(input).toString("base64").replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
}
function escapeHtml(value) {
  return String(value).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
}
function linkifyEscapedText(text) {
  return text.replace(/(https?:\/\/[^\s<]+)/g, (url) => {
    const clean = url.replace(/[),.!?;:]+$/, "");
    const suffix = url.slice(clean.length);
    return `<a href="${clean}" target="_blank" rel="noopener noreferrer">${clean}</a>${suffix}`;
  });
}
function instrumentHtml(html, emailId) {
  let output = String(html || "").replace(/href=(["'])(https?:\/\/[^"']+)\1/gi, (match, quote, url) => {
    const tracked = `${TRACKING_BASE}/track/click/${emailId}?url=${encodeURIComponent(url)}`;
    return `href=${quote}${tracked}${quote}`;
  });
  const pixel = `<img src="${TRACKING_BASE}/track/open/${emailId}.gif" width="1" height="1" alt="" style="display:none!important" />`;
  return output + pixel;
}

app.post("/api/send", async (req, res) => {
  try {
    const { to, subject, body } = req.body || {};
    if (!to || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(to)) return res.status(400).json({ error: "Enter a valid recipient email." });
    if (!subject || !String(subject).trim()) return res.status(400).json({ error: "Subject is required." });
    if (!body || !String(body).trim()) return res.status(400).json({ error: "Email body is required." });

    const connection = await EmailConnection.findOne({ userId: req.session.userId });
    if (!connection) return res.status(400).json({ error: "Connect Gmail before sending." });

    const emailLog = await EmailLog.create({
      userId: req.session.userId, sender: connection.email, recipient: to,
      subject: String(subject).trim(), events: []
    });
    const safeBody = linkifyEscapedText(escapeHtml(body)).replace(/\n/g, "<br>");
    const html = instrumentHtml(`<div style="font-family:Arial,sans-serif;white-space:pre-wrap">${safeBody}</div>`, String(emailLog._id));
    const mime = [
      `From: BlueCode OS <${connection.email}>`,
      `To: ${to}`,
      `Subject: ${String(subject).replace(/[\r\n]/g, " ")}`,
      "MIME-Version: 1.0",
      'Content-Type: text/html; charset="UTF-8"',
      "Content-Transfer-Encoding: base64",
      "",
      Buffer.from(html, "utf8").toString("base64")
    ].join("\r\n");

    const tokens = decrypt(connection.encryptedTokens);
    const oauth2 = oauthClient();
    oauth2.setCredentials(tokens);
    const gmail = google.gmail({ version: "v1", auth: oauth2 });
    const sent = await gmail.users.messages.send({ userId: "me", requestBody: { raw: base64Url(mime) } });

    emailLog.gmailMessageId = sent.data.id;
    emailLog.status = "submitted";
    emailLog.events.push({ type: "submitted", detail: "Gmail API accepted the message for sending." });
    await emailLog.save();
    res.json({ ok: true, id: emailLog._id, message: "Gmail API accepted the message.", sender: connection.email });
  } catch (e) {
    console.error("Send error:", e.message);
    res.status(500).json({ error: e.message || "Unable to send email." });
  }
});

app.get("/api/emails", async (req, res) => {
  const emails = await EmailLog.find({ userId: req.session.userId }).sort({ createdAt: -1 }).limit(100).lean();
  res.json(emails);
});

app.get("/track/open/:id.gif", async (req, res) => {
  try {
    await EmailLog.updateOne(
      { _id: req.params.id },
      { $push: { events: { type: "opened", detail: "Tracking pixel requested", userAgent: req.get("user-agent") || "" } } }
    );
  } catch (_) {}
  const gif = Buffer.from("R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=", "base64");
  res.set({ "Content-Type": "image/gif", "Cache-Control": "no-store, no-cache, must-revalidate, private", "Content-Length": gif.length });
  res.end(gif);
});

app.get("/track/click/:id", async (req, res) => {
  const target = String(req.query.url || "");
  try {
    const parsed = new URL(target);
    if (!["http:", "https:"].includes(parsed.protocol)) throw new Error("Invalid URL");
    await EmailLog.updateOne(
      { _id: req.params.id },
      { $push: { events: { type: "clicked", detail: parsed.hostname, userAgent: req.get("user-agent") || "" } } }
    );
    return res.redirect(302, parsed.toString());
  } catch (_) {
    return res.status(400).send("Invalid tracking destination.");
  }
});

app.get("/health", (req, res) => res.json({ ok: true }));

async function start() {
  if (!process.env.MONGO_URI) throw new Error("MONGO_URI is missing in .env");
  await mongoose.connect(process.env.MONGO_URI);
  console.log("Connected to MongoDB");
  app.listen(PORT, () => console.log(`BlueCode Gmail prototype: http://localhost:${PORT}`));
}
start().catch(err => { console.error(err); process.exit(1); });
